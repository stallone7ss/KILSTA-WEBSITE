# ---------------------------------------------------------------------------
# KILSTA API - server environment
# Copy to server/.env and replace every placeholder. NEVER commit server/.env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Exact browser origin allowed to call the API (no wildcard).
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional trusted origins, e.g. a Vercel preview.
ADDITIONAL_ALLOWED_ORIGINS=

# Supabase project credentials (Project Settings > API).
# Use the publishable (anon) key only to verify user access tokens.
# Use the secret/service_role key ONLY here on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Only needed if a direct PostgreSQL connection is used (it currently is not).
SUPABASE_DB_URL=

# Transactional email: smtp | resend | none
# "none" skips delivery and records notification status as "skipped".
EMAIL_PROVIDER=none
EMAIL_FROM=KILSTA Business & ICT Consultants <no-reply@example.com>
ADMIN_NOTIFICATION_EMAIL=kilsta2023@gmail.com

# Resend provider
EMAIL_API_KEY=

# SMTP provider (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional operational tuning
LOG_LEVEL=info
TRUST_PROXY=1
# Salt used to hash IP addresses in the audit log. Set a long random value.
AUDIT_IP_SALT=
